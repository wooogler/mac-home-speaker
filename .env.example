# mac-home-speaker 설정 파일. setup.sh 가 이 파일을 .env 로 복사하고 API 키와 사는 곳을 채워 넣습니다.
# 직접 고칠 때: .env 를 열어 값을 바꾸고 저장하면, 켜져 있는 스피커가 알아서 다시 시작합니다.
# '#' 으로 시작하는 줄은 기본값을 쓰는 설정입니다. 바꾸려면 '#' 을 지우고 값을 고치세요.

# ---------------------------------------------------------------- 두뇌 (필수: 셋 중 하나)
# 키는 이 맥 안에만 저장됩니다. 여러 개를 넣었으면 SPEAKER_PROVIDER 로 고르세요.
# Claude (권장): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com/api-keys (TTS_BACKEND=openai 목소리에도 쓰임)
OPENAI_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# SPEAKER_PROVIDER=anthropic       # anthropic | openai | google. 비우면 넣어 둔 키로 정함 (Claude 우선)

# ---------------------------------------------------------------- 사는 곳
# 날씨·지역 정보를 찾는 기준입니다. 비우면 AI 가 짐작합니다.
LOCATION_CITY=
LOCATION_REGION=
# 두 글자 국가 코드 (KR, US, JP …)
LOCATION_COUNTRY=
# 비우면 맥의 시간대 설정을 따릅니다. 예: Asia/Seoul
# TIMEZONE=

# ---------------------------------------------------------------- 두뇌
# SPEAKER_MODEL=                   # 비우면 제공자별 빠르고 저렴한 기본 모델. 예: claude-sonnet-5-5
# SPEAKER_EFFORT=low               # 생각의 깊이. 낮을수록 빠름
# MEMORY=on                        # off 면 사용자 기억 기능을 끔 (memory.json)

# ---------------------------------------------------------------- 호출
# WAKE_PHRASE=야 듣고 있어          # 처음 한국어 호출 문구. 말로 등록·삭제한 목록이 있으면 그쪽이 우선
# WAKE_WORD=hey_jarvis             # 영어 호출어 (alexa, hey_mycroft 등). off 로 끔
# WAKE_THRESHOLD=0.5               # 호출어가 잘 안 먹히면 낮추고, 혼자 켜지면 높이기
# WAKE_THRESHOLD_MUSIC=0.25        # 음악이 나오는 동안의 영어 호출어 기준
# WAKE_DUCK_SCORE=0.05             # 음악 중 호출어 비슷한 소리가 들리면 음악을 잠깐 줄이는 기준. 0 이면 끔
# FOLLOW_UP_SECONDS=5              # 답한 뒤 호출어 없이 이어서 듣는 시간. 0 이면 끔

# ---------------------------------------------------------------- 목소리
# TTS_BACKEND=auto                 # auto(=qwen, 로컬) | openai | say(macOS 내장 음성)
# QWEN_TTS_SPEAKER=ono_anna        # sohee, serena, vivian, uncle_fu, dylan, eric, ryan, aiden, ono_anna
# QWEN_TTS_INSTRUCT=A clear, neutral voice.   # 말투 지시문
# VOICE_SPEED=1.2                  # 말 속도 배율 (음높이 유지). 말로 바꾸면 그 값이 유지됨
# SAY_VOICE=Yuna                   # TTS_BACKEND=say 이거나 로컬 음성이 실패했을 때 쓰는 macOS 음성
# OPENAI_TTS_VOICE=coral

# ---------------------------------------------------------------- 음악
# MUSIC_VOLUME=70                  # 음악 재생기 음량의 처음 값
# DUCK_VOLUME=20                   # 스피커가 말하는 동안의 음악 크기
# LISTEN_DUCK_VOLUME=6             # 듣는 동안의 음악 크기. 말을 잘 못 알아들으면 낮추기
# WAKE_MUSIC=duck                  # 호출됐을 때 음악을 duck(작게) 또는 pause(멈춤)
# ANNOUNCE_TRACKS=0                # 1 이면 곡이 바뀔 때마다 제목을 말로 알려 줌

# ---------------------------------------------------------------- 장치
# INPUT_DEVICE=                    # 외장 마이크를 쓸 때 장치 이름 일부 (비우면 시스템 기본)
# OUTPUT_DEVICE=                   # 외장 스피커를 쓸 때 장치 이름 일부

# ---------------------------------------------------------------- 기능 켜고 끄기
# CALENDAR=on                      # 맥 캘린더 앱의 일정 읽기
# MAIL=on                          # 맥 메일 앱의 안 읽은 메일 읽기
# REMOTE=on                        # 같은 Wi-Fi 의 휴대폰 리모컨
# REMOTE_PORT=8443
# AUTO_RELOAD=on                   # 코드가 업데이트되면(git pull 등) 한가할 때 스스로 다시 시작
# AUTO_UPDATE=off                  # on 이면 GitHub 에 새 버전이 올라왔을 때 한가할 때 받아 와 다시 시작
# AUTO_UPDATE_HOURS=1              # 새 버전을 확인하는 간격 (시간)
